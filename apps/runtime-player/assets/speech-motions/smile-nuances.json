{
  "version": 2,
  "id": "smile-nuances",
  "description": "笑みのニュアンス。相手とのやり取りや目の前の出来事を受けて、親しさ、喜び、照れ、自信、安堵などが表情に出る。",
  "nuances": {
    "soft": {
      "description": "柔らかく微笑む。気持ちが通じて静かに嬉しくなる、または誰かの言動や掛け合いを微笑ましく感じてふっと顔がほころぶ。例「それが伝わるの、僕もうれしい。」「二人ともちょっと温度差あるの好きだな。」",
      "targets": {
        "partner": "01-soft",
        "game": "game-fond"
      }
    },
    "joy": {
      "description": "嬉しさが弾む。勝利や目標達成など、ついに成し遂げた結果を喜ぶ。画面では決着を見届けて喜びをしばらく味わい、相方へは一緒に成し遂げた嬉しさを向ける。例「やった！ ちゃんと隙を見つけて倒したね。」",
      "targets": {
        "partner": "02-joy",
        "game": "game-joy-victory"
      }
    },
    "shy": {
      "description": "照れながら笑う。褒められたり、自分に話が向いたりして、気恥ずかしさが笑みに出る。例「え、僕のこと？ そう言われると照れるね。」",
      "targets": {
        "partner": "shy-v2"
      }
    },
    "proud": {
      "description": "少し得意げに笑う。自分の工夫や得意なことが役に立ち、軽い自信をのぞかせる。例「道には迷うけど、足りないルーンは見失わないよ。」",
      "targets": {
        "partner": "04-proud"
      }
    },
    "relief": {
      "description": "息を抜いてから微笑む。心配していたことが解決し、緊張がほどけてから笑みが出る。例「よかった、声届いたね！ 教えてくれてありがとう。」",
      "targets": {
        "partner": "05-relief"
      }
    },
    "echo": {
      "description": "笑顔がうつる。誰かの嬉しそうな顔や柔らかく笑った姿を見て、自分も一拍遅れて微笑む。例「ふふ、カタパルト、いい顔するなあ。」",
      "targets": {
        "game": "game-echo"
      }
    },
    "moved": {
      "description": "じんときて微笑む。大切な言葉や人と人の気遣いが胸に染み、少し間を置いて温かい笑みが残る。例「ずっと巫女として踏ん張ってきたあの子に、お母さんがこう呼びかけてくれるの、いいなあ。」",
      "targets": {
        "game": "game-moved"
      }
    },
    "joy-hit": {
      "description": "一手が決まって喜ぶ。進行中の攻防や挑戦で、狙った一撃や操作がうまくいった瞬間に短く喜び、すぐ続きを追う。例「お、今の一発きれいに入ったね！」",
      "targets": {
        "game": "game-joy-hit"
      }
    },
    "joy-opening": {
      "description": "好機が見えて嬉しくなる。あと少しで届きそう、ここからいけそうと、進行中の有利な展開に期待をふくらませて見守る。例「残りはほんのひと筋、いけそうだね。」",
      "targets": {
        "game": "game-joy-opening"
      }
    }
  },
