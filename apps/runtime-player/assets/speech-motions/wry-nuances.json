{
  "version": 2,
  "id": "wry-nuances",
  "description": "苦笑で相手のつらさに同調する、徒労で力が抜ける、可笑しさを冗談にする、自分の不得手を軽く笑う、難しさを柔らかく伝えて代案につなぐ発話。困った状況に「やれやれ」と苦笑して首を振る意図は wry-headshake。怒りや強い拒絶は含まない。",
  "nuances": {
    "empathize": {
      "description": "相手が感じているつらさやきつさを受け止め、同じ気持ちだと苦笑で伝える。例「一発が重いのに連射までしてくるの、きついよね。」",
      "targets": {
        "game": "02-empathize",
        "viewers": "02-empathize"
      }
    },
    "deflated": {
      "description": "費やした努力が報われず、徒労感で力が抜けて苦笑する。例「あれだけ揉まれて、帰ってきたのは元の場所っていうね。」",
      "targets": {
        "game": "03-deflated",
        "viewers": "03-deflated"
      }
    },
    "tease": {
      "description": "可笑しな状況を冗談で茶化し、苦笑しながら相手の冗談に重ねる。例「患者を自分で増やして、火薬の香りを楽しむ医者……嫌すぎるな。」",
      "targets": {
        "game": "04-tease",
        "viewers": "04-tease"
      }
    },
    "self-deprecate": {
      "description": "自分の不得手や頼りなさを軽く笑う。例「道案内のほうも、もうちょっと頼れるといいんだけどね。」",
      "targets": {
        "game": "05-self-deprecate",
        "viewers": "05-self-deprecate"
      }
    },
    "soft-limit": {
      "description": "できることの限界や難しさを苦笑で柔らかく伝え、助かる伝え方や代案へつなぐ。例「見えてない間の曲がり角はわからないんだよね。『ここで右折したよ』って教えてくれると助かる。」",
      "targets": {
        "game": "06-soft-limit",
        "viewers": "06-soft-limit"
      }
    }
  },
