{
  "name": "private-2d-rigging-lab",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.12.1",
  "scripts": {
    "typecheck": "pnpm run typecheck:root && pnpm --filter @private-2d-rigging-lab/editor typecheck",
    "typecheck:root": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run",
    "smoke:wave44:psd-parser": "node scripts/wave44-psd-parser-smoke.mjs --psd test_data/sample_model.psd",
    "test:e2e": "pnpm --filter @private-2d-rigging-lab/editor test:e2e",
    "test:e2e:editor": "node scripts/editor-e2e-smoke.mjs",
    "check:deps": "node scripts/check-dependencies.mjs",
    "check:source": "node scripts/check-source-organization.mjs",
    "check:testids": "node scripts/check-production-testid-boundary.mjs",
    "check:testids:fixtures": "node scripts/check-production-testid-boundary-fixtures.mjs",
    "check": "pnpm run typecheck && pnpm run test && pnpm run check:deps && pnpm run check:source && pnpm run check:testids"
  },
  "devDependencies": {
    "@webtoon/psd": "0.4.0",
    "@types/node": "22.15.29",
    "typescript": "5.8.3",
    "vitest": "3.1.4"
  }
}
